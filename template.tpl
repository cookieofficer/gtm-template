___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const queryPermission = require('queryPermission');
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const gtagSet = require('gtagSet');
const setInWindow = require('setInWindow');
const getCookieValues = require('getCookieValues');
const encodeUriComponent = require('encodeUriComponent');
const decodeUriComponent = require('decodeUriComponent');
const makeNumber = require('makeNumber');
const JSON = require('JSON');

const siteId = data.siteId;
const origin = 'https://cdn.cookieofficer.com';
const coJsUrl = origin + '/s/' + encodeUriComponent(siteId) + '.js';

const boolOr = function (v, dflt) { return v === undefined ? dflt : v === true; };
const g = function (v) { return v ? 'granted' : 'denied'; };
const consentModeEnabled = data.consentModeEnabled !== false;

if (consentModeEnabled) {
  const wfuRaw = data.waitForUpdate;
  const wfu = (wfuRaw === undefined || wfuRaw === '') ? 2000 : makeNumber(wfuRaw);
  const regionSettings = data.regionSettings || [];
  let hasGlobal = false;

  const applyDefault = function (cd) {
    if (wfu > 0) cd.wait_for_update = wfu;
    setDefaultConsentState(cd);
  };

  for (let i = 0; i < regionSettings.length; i++) {
    const rs = regionSettings[i];
    const cd = {
      'analytics_storage': rs.analyticsStorage,
      'ad_storage': rs.adStorage,
      'ad_user_data': rs.adUserData,
      'ad_personalization': rs.adPersonalization,
      'functionality_storage': rs.functionalityStorage,
      'personalization_storage': rs.personalizationStorage,
      'security_storage': 'granted'
    };
    const parts = (rs.region || '').split(',');
    const regions = [];
    let isGlobal = false;
    for (let j = 0; j < parts.length; j++) {
      const r = parts[j].trim();
      if (!r) continue;
      if (r.toLowerCase() === 'all') { isGlobal = true; continue; }
      regions.push(r.toUpperCase());
    }
    if (!isGlobal && regions.length) cd.region = regions;
    else hasGlobal = true;
    applyDefault(cd);
  }

  if (!hasGlobal) {
    applyDefault({
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied',
      'functionality_storage': 'denied',
      'personalization_storage': 'denied',
      'security_storage': 'granted'
    });
  }

  gtagSet({
    'ads_data_redaction': boolOr(data.adsDataRedaction, true),
    'url_passthrough': boolOr(data.urlPassthrough, true)
  });
}


if (!queryPermission('inject_script', coJsUrl)) return data.gtmOnFailure();
injectScript(coJsUrl, data.gtmOnSuccess, data.gtmOnFailure, coJsUrl);

setInWindow('__coGTM', {
  id: siteId,
  src: coJsUrl,
  lang: data.bannerLang || '',
  channel: 'gtm',
  gcm: consentModeEnabled
}, true);

if (consentModeEnabled) {
  const raw = getCookieValues('co_consent', false)[0];
  if (raw) {
    const decoded = decodeUriComponent(raw);
    if (decoded) {
      const st = JSON.parse(decoded);
      if (st && st.s === siteId && st.c) {
        const c = st.c;
        updateConsentState({
          'analytics_storage': g(c.analytics),
          'ad_storage': g(c.marketing),
          'ad_user_data': g(c.marketing),
          'ad_personalization': g(c.marketing),
          'functionality_storage': g(c.personalization),
          'personalization_storage': g(c.personalization),
          'security_storage': 'granted'
        });
      }
    }
  }
}


